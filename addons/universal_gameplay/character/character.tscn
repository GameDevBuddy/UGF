[gd_scene format=3]

[ext_resource type="Script" path="res://addons/universal_gameplay/entity/definition_binder.gd" id="1_binder"]
[ext_resource type="Script" path="res://addons/universal_gameplay/entity/persistent_identity.gd" id="2_identity"]
[ext_resource type="Script" path="res://addons/universal_gameplay/entity/semantic_state.gd" id="3_state"]
[ext_resource type="Script" path="res://addons/universal_gameplay/locomotion/movement_component.gd" id="4_movement"]
[ext_resource type="Script" path="res://addons/universal_gameplay/camera/camera_adapter.gd" id="5_camera"]
[ext_resource type="Script" path="res://addons/universal_gameplay/animation/animation_adapter.gd" id="6_animation"]
[ext_resource type="Script" path="res://addons/universal_gameplay/character/character_controller.gd" id="7_controller"]
[ext_resource type="Script" path="res://addons/universal_gameplay/interaction/interactor_component.gd" id="8_interactor"]
[ext_resource type="Script" path="res://addons/universal_gameplay/combat/weapon_component.gd" id="9_weapon"]
[ext_resource type="Script" path="res://addons/universal_gameplay/combat/combat_component.gd" id="10_combat"]
[ext_resource type="Script" path="res://addons/universal_gameplay/ai/perceivable.gd" id="11_perceivable"]
[ext_resource type="Script" path="res://addons/universal_gameplay/ai/perception_component.gd" id="12_perception"]
[ext_resource type="Script" path="res://addons/universal_gameplay/ai/navigation_adapter.gd" id="13_navigation"]
[ext_resource type="Script" path="res://addons/universal_gameplay/ai/ai_controller_component.gd" id="14_ai"]
[ext_resource type="Script" path="res://addons/universal_gameplay/dialogue/dialogue_component.gd" id="15_dialogue"]
[ext_resource type="Script" path="res://addons/universal_gameplay/dialogue/dialogue_event_adapter.gd" id="16_dialogue_events"]
[ext_resource type="Script" path="res://addons/universal_gameplay/factions/faction_component.gd" id="17_faction"]
[ext_resource type="Script" path="res://addons/universal_gameplay/factions/faction_ai_adapter.gd" id="18_faction_ai"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]
radius = 0.4
height = 1.8

[node name="Character" type="CharacterBody3D"]

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_body")

[node name="CameraYaw" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.6, 0)

[node name="CameraPitch" type="Node3D" parent="CameraYaw"]

[node name="Camera3D" type="Camera3D" parent="CameraYaw/CameraPitch"]

[node name="PersistentIdentity" type="Node" parent="."]
script = ExtResource("2_identity")

[node name="SemanticState" type="Node" parent="."]
script = ExtResource("3_state")

[node name="MovementComponent" type="Node" parent="." node_paths=PackedStringArray("semantic_state")]
script = ExtResource("4_movement")
semantic_state = NodePath("../SemanticState")

[node name="CameraAdapter" type="Node" parent="." node_paths=PackedStringArray("yaw_pivot", "pitch_pivot", "camera", "movement")]
script = ExtResource("5_camera")
yaw_pivot = NodePath("../CameraYaw")
pitch_pivot = NodePath("../CameraYaw/CameraPitch")
camera = NodePath("../CameraYaw/CameraPitch/Camera3D")
movement = NodePath("../MovementComponent")

[node name="AnimationAdapter" type="Node" parent="." node_paths=PackedStringArray("movement")]
script = ExtResource("6_animation")
movement = NodePath("../MovementComponent")

[node name="CharacterController" type="Node" parent="." node_paths=PackedStringArray("movement", "camera", "interactor", "combat", "ai")]
script = ExtResource("7_controller")
movement = NodePath("../MovementComponent")
camera = NodePath("../CameraAdapter")
interactor = NodePath("../InteractorComponent")
combat = NodePath("../CombatComponent")
ai = NodePath("../AIControllerComponent")

[node name="InteractorComponent" type="Node" parent="." node_paths=PackedStringArray("semantic_state")]
script = ExtResource("8_interactor")
semantic_state = NodePath("../SemanticState")

[node name="WeaponComponent" type="Node" parent="." node_paths=PackedStringArray("semantic_state")]
script = ExtResource("9_weapon")
semantic_state = NodePath("../SemanticState")

[node name="CombatComponent" type="Node" parent="." node_paths=PackedStringArray("weapon", "semantic_state", "aim")]
script = ExtResource("10_combat")
weapon = NodePath("../WeaponComponent")
semantic_state = NodePath("../SemanticState")
aim = NodePath("../CameraYaw/CameraPitch/Camera3D")

[node name="Perceivable" type="Node" parent="." node_paths=PackedStringArray("semantic_state")]
script = ExtResource("11_perceivable")
semantic_state = NodePath("../SemanticState")
concealing_states = Array[StringName]([&"state.movement.crouching"])

[node name="PerceptionComponent" type="Node" parent="." node_paths=PackedStringArray("perceivable", "eyes")]
script = ExtResource("12_perception")
perceivable = NodePath("../Perceivable")
eyes = NodePath("../CameraYaw")

[node name="NavigationAdapter" type="Node" parent="."]
script = ExtResource("13_navigation")

[node name="AIControllerComponent" type="Node" parent="." node_paths=PackedStringArray("perception", "movement", "navigation", "combat", "interactor", "semantic_state")]
script = ExtResource("14_ai")
perception = NodePath("../PerceptionComponent")
movement = NodePath("../MovementComponent")
navigation = NodePath("../NavigationAdapter")
combat = NodePath("../CombatComponent")
interactor = NodePath("../InteractorComponent")
semantic_state = NodePath("../SemanticState")

[node name="DialogueComponent" type="Node" parent="."]
script = ExtResource("15_dialogue")

[node name="DialogueEventAdapter" type="Node" parent="." node_paths=PackedStringArray("dialogue")]
script = ExtResource("16_dialogue_events")
dialogue = NodePath("../DialogueComponent")

[node name="FactionComponent" type="Node" parent="."]
script = ExtResource("17_faction")

[node name="FactionAIAdapter" type="Node" parent="." node_paths=PackedStringArray("controller")]
script = ExtResource("18_faction_ai")
controller = NodePath("../AIControllerComponent")

[node name="DefinitionBinder" type="Node" parent="."]
script = ExtResource("1_binder")
